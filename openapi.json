{
  "openapi": "3.1.0",
  "info": {
    "title": "Hew Playground API",
    "version": "0.11.1",
    "summary": "HTTP API for compiling, running, listing, and sharing Hew playground programs.",
    "description": "The Hew playground exposes a small JSON-over-HTTP API backed by an identity-verified compiler registry. Dotted paths, grouped selections, contextual variants, and the migration diagnostics shown in the illustrative examples are compiler-version-dependent.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3030",
      "description": "Default local development server"
    },
    {
      "url": "https://livecode-v1.hew.sh",
      "description": "Default live server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness and health checks."
    },
    {
      "name": "execution",
      "description": "Compile, run, and test Hew programs."
    },
    {
      "name": "examples",
      "description": "Built-in example programs baked into the binary."
    },
    {
      "name": "sharing",
      "description": "Persistent snippet storage and retrieval."
    }
  ],
  "paths": {
    "/live": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getLive",
        "summary": "Liveness check",
        "description": "Returns HTTP 200 without checking worker readiness.",
        "responses": {
          "200": {
            "description": "The API process is alive.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                },
                "examples": {
                  "ok": {
                    "value": "ok"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getHealth",
        "summary": "Readiness check",
        "description": "Returns HTTP 200 with an empty body and `Cache-Control: no-store` when usable sandbox worker capabilities are cached, or HTTP 503 otherwise.",
        "responses": {
          "200": {
            "description": "Usable sandbox worker capabilities are cached."
          },
          "503": {
            "description": "No usable sandbox worker capabilities are currently cached."
          }
        }
      }
    },
    "/api/versions": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getVersions",
        "summary": "List available compiler versions",
        "description": "Returns the startup-validated default and all installed compiler versions in semver-descending order.",
        "responses": {
          "200": {
            "description": "Available compiler versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionsResponse"
                },
                "examples": {
                  "multiVersion": {
                    "value": {
                      "default_version": "0.11.1",
                      "available_versions": [
                        "0.11.1",
                        "0.11.0",
                        "0.10.0",
                        "0.9.3",
                        "0.8.0",
                        "0.7.0",
                        "0.5.1",
                        "0.4.0",
                        "0.3.0",
                        "0.2.0"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "No usable sandbox worker capabilities are currently cached."
          }
        }
      }
    },
    "/api/run": {
      "post": {
        "tags": [
          "execution"
        ],
        "operationId": "runCode",
        "summary": "Compile and run Hew source code",
        "description": "Normal native program results return HTTP 200 even when compilation fails or the program exits unsuccessfully. Resource and validation failures use non-2xx status codes. The worker's authenticated capabilities select the default and available labels. The client transports source and opaque compiler stderr; diagnostic text is compiler-version-dependent.",
        "parameters": [
          {
            "name": "X-Hew-Version",
            "in": "header",
            "required": false,
            "description": "Alternative version selector. The body field takes priority. Labels must exactly match a currently available worker compiler.",
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
              "example": "0.11.1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              },
              "examples": {
                "helloWorld": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }"
                  }
                },
                "dottedSurface": {
                  "summary": "Hew dotted and contextual syntax",
                  "description": "Illustrative source using dotted module paths and contextual enum variants.",
                  "value": {
                    "source": "import std.io.scanner.{words};\n\nenum Greeting {\n  Message(string);\n}\n\nfn main() {\n  let tokens = words(\"hello\");\n  let greeting: Greeting = .Message(\"hello\");\n  match greeting {\n    .Message(text) => println(f\"{text} ({tokens.len()})\"),\n  }\n}"
                  }
                },
                "legacyPathSeparatorRc2": {
                  "summary": "Illustrative Hew 0.6.1 legacy-path input",
                  "description": "This source is paired with the illustrative rc2 response below. The client sends it unchanged; server compiler availability and diagnostics are version-dependent.",
                  "value": {
                    "source": "import std::io::scanner::{words};\n\nfn main() {\n  println(words(\"hello\").len());\n}"
                  }
                },
                "legacyTurbofishRc2": {
                  "summary": "Illustrative Hew 0.6.1 legacy-turbofish input",
                  "description": "This source is paired with the illustrative rc2 response below. The client sends it unchanged; server compiler availability and diagnostics are version-dependent.",
                  "value": {
                    "source": "fn main() {\n  let value = parse::<i64>(\"42\");\n  println(value);\n}"
                  }
                },
                "withVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.11.1"
                  }
                },
                "withWasmExecution": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "execution_mode": "wasm"
                  }
                },
                "legacyVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.2.0"
                  }
                },
                "retainedVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.3.0"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compile/run completed. `success` can still be false for compile errors or signal kills. A non-zero program return value is reported in `exit_code` while `success` remains true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "stdout": "hello\n",
                      "stderr": "",
                      "elapsed_ms": 18,
                      "compiler_version": "0.11.1",
                      "execution_mode": "native"
                    }
                  },
                  "compileError": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "",
                      "compile_error": "error: parse error at line 1",
                      "elapsed_ms": 12,
                      "compiler_version": "0.11.1",
                      "execution_mode": "native"
                    }
                  },
                  "legacyPathSeparatorRc2": {
                    "summary": "Illustrative Hew 0.6.1 legacy-path diagnostic",
                    "description": "Illustrative compiler stderr for the `legacyPathSeparatorRc2` source request. The client preserves it as opaque text; source-location context and diagnostic text are compiler-version-dependent.",
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "",
                      "compile_error": "error: E_PATH_LEGACY_SEPARATOR: `::` path separators have been removed; use dotted paths: `import std.io.scanner.{words};`\n  = help: use the migrated spelling `import std.io.scanner.{words};`",
                      "elapsed_ms": 12,
                      "compiler_version": "0.6.0-rc2",
                      "execution_mode": "native"
                    }
                  },
                  "legacyTurbofishRc2": {
                    "summary": "Illustrative Hew 0.6.1 legacy-turbofish diagnostic",
                    "description": "Illustrative compiler stderr for the `legacyTurbofishRc2` source request. The client preserves it as opaque text; source-location context and diagnostic text are compiler-version-dependent.",
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "",
                      "compile_error": "error: E_LEGACY_TURBOFISH: Rust-style `::<...>` has been removed; use Hew generic application: `let value = parse<i64>(\"42\");`\n  = help: use the migrated spelling `let value = parse<i64>(\"42\");`",
                      "elapsed_ms": 12,
                      "compiler_version": "0.6.0-rc2",
                      "execution_mode": "native"
                    }
                  },
                  "nonZeroExit": {
                    "value": {
                      "success": true,
                      "stdout": "",
                      "stderr": "",
                      "exit_code": 2,
                      "elapsed_ms": 4,
                      "compiler_version": "0.11.1",
                      "execution_mode": "native"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`source` exceeded 64 KiB or `compiler_version` / `X-Hew-Version` was empty or unsupported) returning `application/json`, or Axum rejected malformed JSON (`JsonSyntaxError`) with `text/plain`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "sourceTooLarge": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Source code too large (65537 bytes, max 65536)",
                      "elapsed_ms": 0
                    }
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "The total HTTP request body exceeded the Axum body limit before handler execution.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "The request body did not carry an `application/json` content type.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Server-side WASM execution is unavailable (`application/json` `RunResponse`; `execution_mode: wasm` is accepted for compatibility and never converted to native execution), or Axum rejected valid JSON that failed `RunRequest` deserialization (`text/plain` `JsonDataError`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "The per-IP CPU budget or the concurrent-run limit was exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "rateLimit": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Rate limit exceeded, please wait before trying again",
                      "elapsed_ms": 0,
                      "compiler_version": "0.11.1"
                    }
                  },
                  "concurrencyLimit": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Too many concurrent requests, please try again",
                      "elapsed_ms": 0,
                      "compiler_version": "0.11.1"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The private worker is unavailable or incompatible. The response contains a correlated generic error without control-plane details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/test": {
      "post": {
        "tags": [
          "execution"
        ],
        "operationId": "runTests",
        "summary": "Discover or run Hew tests in one source file",
        "description": "Returns the same newline-delimited JSON events as `hew test --format json`. Events stream as the isolated native test process runs. Requests share the /api/run source, rate, concurrency and resource controls, with a 30-second total test deadline. Test failures are reported in events and return HTTP 200. A compile error, timeout or worker failure ends the stream with one `{\"event\":\"error\",\"message\":...}` line.",
        "parameters": [
          {
            "name": "X-Hew-Version",
            "in": "header",
            "required": false,
            "description": "Alternative version selector. The body field takes priority. Labels must exactly match a currently available worker compiler.",
            "schema": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
              "example": "0.11.1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test discovery or run events, one JSON object per line.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid source, test selection, or compiler selection returning one NDJSON `{\"event\":\"error\",\"message\":...}` line (`application/x-ndjson`), or malformed JSON rejected by Axum (`text/plain` `JsonSyntaxError`).",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "The total HTTP request body exceeded the Axum body limit before handler execution.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "The request body did not carry an `application/json` content type.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON failed `TestRequest` deserialization (rejected by Axum `JsonDataError`).",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Rate or concurrency limit exceeded. Returns one NDJSON `{\"event\":\"error\",\"message\":...}` line.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "No compatible sandbox worker is ready. Returns one NDJSON `{\"event\":\"error\",\"message\":...}` line.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "tags": [
          "examples"
        ],
        "operationId": "listExamples",
        "summary": "List built-in example programs",
        "responses": {
          "200": {
            "description": "Examples baked into the binary at build time.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Example"
                  }
                },
                "examples": {
                  "exampleList": {
                    "value": [
                      {
                        "name": "Hello, world",
                        "description": "A minimal program",
                        "category": "Basics",
                        "source": "fn main() { println(\"hello\"); }",
                        "capabilities": {
                          "browser": "analysis-only",
                          "wasi": "runnable"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/share": {
      "post": {
        "tags": [
          "sharing"
        ],
        "operationId": "createShare",
        "summary": "Store a snippet and return its share ID",
        "description": "Share ID of the stored snippet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareRequest"
              },
              "examples": {
                "shareSource": {
                  "value": {
                    "source": "fn main() { println(1); }"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snippet stored successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "created": {
                    "value": {
                      "id": "8d7b8d8bdb9f6939"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`source` exceeded 64 KiB) returning `application/json` (`{ \"id\": \"\" }`), or malformed JSON rejected by Axum (`text/plain` `JsonSyntaxError`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "sourceTooLarge": {
                    "value": {
                      "id": ""
                    }
                  }
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "The total HTTP request body exceeded the Axum body limit before handler execution.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "The request body did not carry an `application/json` content type.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Valid JSON failed `ShareRequest` deserialization (rejected by Axum `JsonDataError`).",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Per-IP share rate limit exhausted; retry later. Returns JSON `{\"id\":\"\"}` — distinguish by status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "rateLimited": {
                    "value": {
                      "id": ""
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Share store at capacity; snippet rejected. Returns JSON `{\"id\":\"\"}` — distinguish by status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "storeFull": {
                    "value": {
                      "id": ""
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/share/{id}": {
      "get": {
        "tags": [
          "sharing"
        ],
        "operationId": "getShare",
        "summary": "Fetch a previously shared snippet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Snippet identifier returned by `POST /api/share`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snippet found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareGetResponse"
                },
                "examples": {
                  "found": {
                    "value": {
                      "source": "fn main() { println(1); }"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No snippet exists for the supplied ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing": {
                    "value": {
                      "error": "snippet not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TestRequest": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Hew source, at most 64 KiB."
          },
          "compiler_version": {
            "type": ["string", "null"],
            "description": "Optional installed compiler version; when omitted or null, falls back to X-Hew-Version and then the first authenticated worker capability. Values must exactly match an available worker compiler.",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
            "example": "0.11.1"
          },
          "list_only": {
            "type": "boolean",
            "default": false,
            "description": "Emit test_discovered events without executing tests."
          },
          "test": {
            "type": ["string", "null"],
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_]+$",
            "description": "Optional bare test identifier returned by discovery (max 128 ASCII alphanumeric or underscore characters; disallowed when `list_only` is true)."
          }
        }
      },
      "RunRequest": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Hew source code. The handler rejects strings larger than 64 KiB."
          },
          "compiler_version": {
            "type": ["string", "null"],
            "description": "Compiler version to use. When omitted or null, falls back to X-Hew-Version and then the first authenticated worker capability. Values must exactly match an available worker compiler.",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$",
            "example": "0.11.1"
          },
          "execution_mode": {
            "type": ["string", "null"],
            "enum": [
              "native",
              "wasm",
              null
            ],
            "default": "native",
            "description": "Execution lane. \"native\" (or omitted/null) is the only server-side execution mode. \"wasm\" remains in this request schema for compatibility and returns HTTP 422 without native fallback."
          }
        }
      },
      "RunResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "stdout",
          "stderr",
          "elapsed_ms"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when `hew build` and native execution completed normally. A non-zero program return value still counts as success."
          },
          "stdout": {
            "type": "string",
            "description": "Captured standard output, truncated after 64 KiB."
          },
          "stderr": {
            "type": "string",
            "description": "Captured standard error with internal `[hew-pprof]` lines removed."
          },
          "compile_error": {
            "type": "string",
            "description": "Opaque compiler stderr, present only when `hew build` exits non-zero."
          },
          "exit_code": {
            "type": "integer",
            "format": "int32",
            "description": "Program return value when the program ran to completion and returned a non-zero exit code."
          },
          "elapsed_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "End-to-end wall-clock duration in milliseconds."
          },
          "profile": {
            "type": "string",
            "description": "Profiler output from `hew-profile.txt`, when available."
          },
          "compiler_version": {
            "type": "string",
            "description": "The identity-verified compiler version used for this run; absent when validation or unavailable worker capabilities rejected the request before compiler selection.",
            "example": "0.11.1"
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "native"
            ],
            "description": "Admitted server-side runs (HTTP 200) are always native. Absent when validation or control-plane admission rejected the request.",
            "example": "native"
          }
        }
      },
      "Example": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "category",
          "source",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Category name from the playground manifest, or title-cased directory name in legacy layout."
          },
          "source": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/ExampleCapabilities"
          }
        }
      },
      "ExampleCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "description": "Execution capability tier for this example.",
        "required": [
          "browser",
          "wasi"
        ],
        "properties": {
          "browser": {
            "type": "string",
            "enum": [
              "analysis-only"
            ],
            "description": "Browser capability. Always 'analysis-only' because the browser lane exposes analysis only."
          },
          "wasi": {
            "type": "string",
            "enum": [
              "runnable",
              "unsupported"
            ],
            "description": "WASI capability. 'runnable' executes under wasm32-wasi; 'unsupported' hits a known unsupported WASM path."
          }
        }
      },
      "ShareRequest": {
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Hew source code to store."
          },
          "compiler_version": {
            "type": ["string", "null"],
            "deprecated": true,
            "description": "Deprecated and ignored by the server; snippets store source only. Retained for compatibility with existing SDK callers."
          }
        }
      },
      "ShareResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "On success, a 16-character lowercase hexadecimal snippet ID. On oversized requests (HTTP 400), rate limits (HTTP 429), or a full share store (HTTP 503), the handler returns an empty string."
          }
        }
      },
      "ShareGetResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "VersionsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "default_version",
          "available_versions"
        ],
        "properties": {
          "default_version": {
            "type": "string",
            "description": "The default compiler version used when none is specified.",
            "example": "0.11.1"
          },
          "available_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "All startup-validated compiler versions in descending semantic-version order.",
            "example": [
              "0.11.1",
              "0.11.0",
              "0.10.0",
              "0.9.3",
              "0.8.0",
              "0.7.0",
              "0.5.1",
              "0.4.0",
              "0.3.0",
              "0.2.0"
            ]
          }
        }
      }
    }
  }
}
