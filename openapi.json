{
  "openapi": "3.1.0",
  "info": {
    "title": "Hew Playground API",
    "version": "0.5.0",
    "summary": "HTTP API for compiling, running, listing, and sharing Hew playground programs.",
    "description": "The Hew playground exposes a small JSON-over-HTTP API. Supports multiple compiler versions (v0.5.0 default, v0.4.0 retained, v0.3.0 and v0.2.0 legacy).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3030",
      "description": "Default local development server"
    },
    {
      "url": "https://livecode-v1.hew.sh",
      "description": "Default live server"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness and health checks."
    },
    {
      "name": "execution",
      "description": "Compile and run Hew programs."
    },
    {
      "name": "examples",
      "description": "Built-in example programs baked into the binary."
    },
    {
      "name": "sharing",
      "description": "Persistent snippet storage and retrieval."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getHealth",
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "The server is healthy.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                },
                "examples": {
                  "ok": {
                    "value": "ok"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/versions": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "getVersions",
        "summary": "List available compiler versions",
        "description": "Returns the default compiler version and all versions available on this server.",
        "responses": {
          "200": {
            "description": "Available compiler versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionsResponse"
                },
                "examples": {
                  "multiVersion": {
                    "value": {
                      "default_version": "0.5.0",
                      "available_versions": [
                        "0.5.0",
                        "0.4.0",
                        "0.3.0",
                        "0.2.0"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/run": {
      "post": {
        "tags": [
          "execution"
        ],
        "operationId": "runCode",
        "summary": "Compile and run Hew source code",
        "description": "Normal program results return HTTP 200 even when compilation fails or the program exits unsuccessfully. Resource and validation failures use non-2xx status codes. Use `compiler_version` to target a specific Hew compiler version (defaults to 0.5.0). Hew source uses dotted paths and `.{ }` grouped selections; legacy `::` paths, glob imports, and turbofish are compile errors with migration diagnostics.",
        "parameters": [
          {
            "name": "X-Hew-Version",
            "in": "header",
            "required": false,
            "description": "Alternative way to specify compiler version. The `compiler_version` field in the request body takes priority.",
            "schema": {
              "type": "string",
              "enum": [
                "0.5.0",
                "0.4.0",
                "0.3.0",
                "0.2.0"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              },
              "examples": {
                "helloWorld": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }"
                  }
                },
                "dottedSurface": {
                  "value": {
                    "source": "import std.io.scanner.{words};\n\nenum Greeting {\n  Message(string);\n}\n\nfn main() {\n  let tokens = words(\"hello\");\n  let greeting: Greeting = .Message(\"hello\");\n  match greeting {\n    .Message(text) => println(text),\n  }\n  println(tokens.len());\n}"
                  }
                },
                "withVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.5.0"
                  }
                },
                "withWasmExecution": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "execution_mode": "wasm"
                  }
                },
                "legacyVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.2.0"
                  }
                },
                "retainedVersion": {
                  "value": {
                    "source": "fn main() { println(\"hello\"); }",
                    "compiler_version": "0.3.0"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compile/run completed. `success` can still be false for compile errors or signal kills. A non-zero program return value is reported in `exit_code` while `success` remains true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "stdout": "hello\n",
                      "stderr": "",
                      "elapsed_ms": 18,
                      "compiler_version": "0.5.0"
                    }
                  },
                  "legacyPathSeparator": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "",
                      "compile_error": "error[E_PATH_LEGACY_SEPARATOR]: `::` path separators are retired\nhelp: use dotted paths instead",
                      "elapsed_ms": 12,
                      "compiler_version": "0.5.0"
                    }
                  },
                  "legacyTurbofish": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "",
                      "compile_error": "error[E_LEGACY_TURBOFISH]: turbofish syntax is retired\nhelp: use contextual type inference instead",
                      "elapsed_ms": 12,
                      "compiler_version": "0.5.0"
                    }
                  },
                  "nonZeroExit": {
                    "value": {
                      "success": true,
                      "stdout": "",
                      "stderr": "",
                      "exit_code": 2,
                      "elapsed_ms": 4,
                      "compiler_version": "0.5.0"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The JSON body parsed successfully, but the `source` field exceeded 64 KiB. Malformed JSON may also be rejected by Axum before the handler runs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "sourceTooLarge": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Source code too large (65537 bytes, max 65536)",
                      "elapsed_ms": 0
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "The total HTTP request body exceeded the Axum body limit before handler execution."
          },
          "415": {
            "description": "The request body was not sent as JSON."
          },
          "429": {
            "description": "The per-IP CPU budget or the concurrent-run limit was exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                },
                "examples": {
                  "rateLimit": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Rate limit exceeded, please wait before trying again",
                      "elapsed_ms": 0
                    }
                  },
                  "concurrencyLimit": {
                    "value": {
                      "success": false,
                      "stdout": "",
                      "stderr": "Too many concurrent requests, please try again",
                      "elapsed_ms": 0
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal sandbox or process-launch error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "tags": [
          "examples"
        ],
        "operationId": "listExamples",
        "summary": "List built-in example programs",
        "responses": {
          "200": {
            "description": "Examples baked into the binary at build time.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Example"
                  }
                },
                "examples": {
                  "exampleList": {
                    "value": [
                      {
                        "name": "Hello, world",
                        "description": "A minimal program",
                        "category": "Basics",
                        "source": "fn main() { println(\"hello\"); }",
                        "capabilities": {
                          "browser": "analysis-only",
                          "wasi": "runnable"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/share": {
      "post": {
        "tags": [
          "sharing"
        ],
        "operationId": "createShare",
        "summary": "Store a snippet and return its share ID",
        "description": "Share ID of the stored snippet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShareRequest"
              },
              "examples": {
                "shareSource": {
                  "value": {
                    "source": "fn main() { println(1); }"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snippet stored successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "created": {
                    "value": {
                      "id": "8d7b8d8bdb9f6939"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The JSON body parsed successfully, but the `source` field exceeded 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareResponse"
                },
                "examples": {
                  "sourceTooLarge": {
                    "value": {
                      "id": ""
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "The total HTTP request body exceeded the Axum body limit before handler execution."
          },
          "415": {
            "description": "The request body was not sent as JSON."
          },
          "429": {
            "description": "Per-IP share rate limit exhausted; retry later. Body shape matches 400 (`{ \"id\": \"\" }`) — distinguish by status."
          },
          "503": {
            "description": "Share store at capacity; snippet rejected. Body shape matches 400 (`{ \"id\": \"\" }`) — distinguish by status."
          }
        }
      }
    },
    "/api/share/{id}": {
      "get": {
        "tags": [
          "sharing"
        ],
        "operationId": "getShare",
        "summary": "Fetch a previously shared snippet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Snippet identifier returned by `POST /api/share`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snippet found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareGetResponse"
                },
                "examples": {
                  "found": {
                    "value": {
                      "source": "fn main() { println(1); }"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No snippet exists for the supplied ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing": {
                    "value": {
                      "error": "snippet not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Hew source code. Use dotted paths and `.{ }` grouped selections; variants are contextual (for example, `.Ready`). The handler rejects strings larger than 64 KiB."
          },
          "compiler_version": {
            "type": "string",
            "description": "Compiler version to use. Defaults to `0.5.0` when omitted.",
            "enum": [
              "0.5.0",
              "0.4.0",
              "0.3.0",
              "0.2.0"
            ],
            "default": "0.5.0"
          },
          "execution_mode": {
            "type": "string",
            "enum": [
              "native",
              "wasm"
            ],
            "default": "native",
            "description": "Execution lane. \"native\" (default) compiles and runs as a subprocess. \"wasm\" compiles to wasm32-wasip1 and runs in-process via wasmtime (requires HEW_WASM_EXEC_ENABLED=1 on the server)."
          }
        }
      },
      "RunResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "stdout",
          "stderr",
          "elapsed_ms",
          "compiler_version"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "True when `hew run` completed normally. A non-zero program return value still counts as success."
          },
          "stdout": {
            "type": "string",
            "description": "Captured standard output, truncated after 64 KiB."
          },
          "stderr": {
            "type": "string",
            "description": "Captured standard error with internal `[hew-pprof]` lines removed."
          },
          "compile_error": {
            "type": "string",
            "description": "Compiler stderr, present only when the Hew compiler exits with its dedicated compile-error code. Legacy `::` paths emit `E_PATH_LEGACY_SEPARATOR`; legacy turbofish emits `E_LEGACY_TURBOFISH`. Each diagnostic includes a migration suggestion."
          },
          "exit_code": {
            "type": "integer",
            "format": "int32",
            "description": "Program return value when the program ran to completion and returned a non-zero exit code."
          },
          "elapsed_ms": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "End-to-end wall-clock duration in milliseconds."
          },
          "profile": {
            "type": "string",
            "description": "Profiler output from `hew-profile.txt`, when available."
          },
          "compiler_version": {
            "type": "string",
            "description": "The compiler version that was used for this run (e.g. \"0.5.0\").",
            "example": "0.5.0"
          }
        }
      },
      "Example": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "category",
          "source",
          "capabilities"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "Title-cased category derived from the example name."
          },
          "source": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/ExampleCapabilities"
          }
        }
      },
      "ExampleCapabilities": {
        "type": "object",
        "additionalProperties": false,
        "description": "Execution capability tier for this example.",
        "required": [
          "browser",
          "wasi"
        ],
        "properties": {
          "browser": {
            "type": "string",
            "enum": [
              "analysis-only"
            ],
            "description": "Browser capability. Always 'analysis-only' because the browser lane exposes analysis only."
          },
          "wasi": {
            "type": "string",
            "enum": [
              "runnable",
              "unsupported"
            ],
            "description": "WASI capability. 'runnable' executes under wasm32-wasi; 'unsupported' hits a known unsupported WASM path."
          }
        }
      },
      "ShareRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Hew source code to store."
          },
          "compiler_version": {
            "type": "string",
            "description": "Optional compiler version to pin the snippet to (e.g. \"0.5.0\"). Omit to let the server default."
          }
        }
      },
      "ShareResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "On success, a 16-character lowercase hexadecimal snippet ID. On oversized requests, the handler returns an empty string with HTTP 400."
          }
        }
      },
      "ShareGetResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "VersionsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "default_version",
          "available_versions"
        ],
        "properties": {
          "default_version": {
            "type": "string",
            "description": "The default compiler version used when none is specified.",
            "example": "0.5.0"
          },
          "available_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "All compiler versions available on this server.",
            "example": [
              "0.5.0",
              "0.4.0",
              "0.3.0",
              "0.2.0"
            ]
          }
        }
      }
    }
  }
}
